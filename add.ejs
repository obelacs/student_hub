<%- include("../partials/header") %>

<main class="container py-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
      <li class="breadcrumb-item active" aria-current="page">Add a course</li>
    </ol>
  </nav>

  <h1 class="h3 mb-4">Add a course</h1>

  <div class="row g-4">
    <!-- Create / add by code -->
    <section class="col-lg-6" aria-labelledby="create-heading">
      <div class="card">
        <div class="card-body p-4">
          <h2 class="h5" id="create-heading">Create a course</h2>
          <p class="text-body-secondary small">
            If the course code already exists, we'll add the existing course to your list instead of creating a duplicate.
          </p>

          <% if (errors.length) { %>
            <div class="alert alert-danger" role="alert">
              <ul class="mb-0 ps-3">
                <% errors.forEach(function (e) { %><li><%= e %></li><% }); %>
              </ul>
            </div>
          <% } %>

          <form method="POST" action="/courses/add" novalidate>
            <div class="row g-3">
              <div class="col-sm-5">
                <label for="code" class="form-label">Course code</label>
                <input type="text" class="form-control" id="code" name="code" placeholder="CMP 301" maxlength="10" value="<%= form.code || '' %>" required />
              </div>
              <div class="col-sm-7">
                <label for="semester" class="form-label">Semester</label>
                <select class="form-select" id="semester" name="semester" required>
                  <option value="" disabled <%= form.semester ? "" : "selected" %>>Choose semester</option>
                  <% semesters.forEach(function (s) { %>
                    <option value="<%= s %>" <%= form.semester === s ? "selected" : "" %>><%= s %> semester</option>
                  <% }); %>
                </select>
              </div>
              <div class="col-12">
                <label for="name" class="form-label">Course title</label>
                <input type="text" class="form-control" id="name" name="name" placeholder="Database Management Systems" maxlength="150" value="<%= form.name || '' %>" required />
              </div>
              <div class="col-12">
                <label for="description" class="form-label">Description <span class="text-body-secondary">(optional)</span></label>
                <textarea class="form-control" id="description" name="description" rows="3" maxlength="1000"><%= form.description || "" %></textarea>
              </div>
              <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-dark">Save and add to my courses</button>
                <a href="/dashboard" class="btn btn-outline-secondary">Cancel</a>
              </div>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- Join existing -->
    <section class="col-lg-6" aria-labelledby="existing-heading">
      <div class="card">
        <div class="card-body p-4">
          <h2 class="h5" id="existing-heading">Join an existing course</h2>

          <form method="GET" action="/courses/add" class="input-group mb-3" role="search">
            <input type="search" class="form-control" name="q" value="<%= q %>" placeholder="Search by code or title" aria-label="Search courses" />
            <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i><span class="visually-hidden">Search</span></button>
          </form>

          <% if (available.length === 0) { %>
            <p class="text-body-secondary small mb-0">
              <%= q ? "No courses match your search." : "There are no other courses to join yet." %>
            </p>
          <% } else { %>
            <ul class="list-group list-group-flush">
              <% available.forEach(function (c) { %>
                <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-3">
                  <div>
                    <div class="fw-medium"><%= c.code %> <span class="text-body-secondary fw-normal">· <%= c.semester %></span></div>
                    <div class="small text-body-secondary"><%= c.name %></div>
                  </div>
                  <form method="POST" action="/courses/<%= c.id %>/enroll">
                    <button class="btn btn-sm btn-outline-dark" type="submit">Add</button>
                  </form>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </div>
      </div>
    </section>
  </div>
</main>

<%- include("../partials/footer") %>
