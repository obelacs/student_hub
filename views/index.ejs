<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Hub</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    
    
    <!-- min-vh-100 makes it full height, d-flex and align-items-center vertically center the content -->
    <div class="hero-section min-vh-100 d-flex align-items-center">
      <div class="container px-4 py-5">
        <div class="row justify-content-center text-center">
          <div class="col-lg-8">
            <h1 class="display-4 fw-bold text-white lh-1 mb-4">
              Welcome to Student Study Hub.
            </h1>
            
            <!-- Updated Paragraph -->
            <p class="lead text-light mb-5">
              Streamline your learning experience. Organize your notes, master your coursework, and practice with a comprehensive archive of past questions—all in one centralized platform.
            </p>
            
            <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
              <a href="/signup" class="btn btn-primary btn-lg px-4 fw-bold">
                Get started
              </a>
              <!-- Changed to btn-outline-light so it shows up well on the dark overlay -->
              <a href="/login" class="btn btn-outline-light btn-lg px-4">
                Login
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>


    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
